<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Disable directory indexes
  Options -Indexes

  # Allow large payload uploads (base64 images, PDFs up to 100MB)
  LimitRequestBody 104857600

  # ── Security: Deny direct HTTP access to data folders and sensitive file extensions ──
  RewriteRule ^(data|public/data|server)/ - [F,L]
  RewriteRule \.(json|sql|env|log|md|yml|yaml|sh|git|gitignore|lock)$ - [F,L]

  # ── Pass Authorization header to PHP (FastCGI / PHP-FPM) ──
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # 1. Route API requests to PHP router
  RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

  # 2. Route Admin requests to PHP controller
  RewriteRule ^admin(/.*)?$ admin/index.php [QSA,L]

  # 3. Direct static serving for robots.txt and sitemap.xml
  RewriteRule ^robots\.txt$ robots.txt [L]
  RewriteRule ^sitemap\.xml$ sitemap.xml [L]

  # 4. Explicitly force all React application routes to index.html
  RewriteRule ^(solutions|produits|services|marques|temoignages|devis|blog|recrutement|a-propos|contact|espace-client|intranet)(/.*)?$ index.html [L]

  # 5. If requested static file physically exists (assets, images, fonts, etc.), serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 6. Fallback everything else to index.html for React SPA
  RewriteRule ^ index.html [L]
</IfModule>

# ── Security Headers ────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# ── Browser Caching & Performance ──────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images and icons
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"

  # Fonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # CSS & JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>

# ── Prevent Direct Access to Hidden or Sensitive Files ─────────────
<FilesMatch "^\.(env|git|htaccess)|(\.json|\.sql|\.log|\.md|\.sh|\.lock)$">
  Order allow,deny
  Deny from all
</FilesMatch>
