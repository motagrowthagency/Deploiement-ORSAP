<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Disable directory indexes
  Options -Indexes

  # Allow large payload uploads (base64 images, PDFs up to 100MB)
  LimitRequestBody 104857600

  # ── Security: Deny direct HTTP access to data folders and sensitive file extensions ──
  RewriteRule ^(data|public/data|server)/ - [F,L]
  RewriteRule \.(json|sql|env|log|md|yml|yaml|sh|git|gitignore|lock)$ - [F,L]

  # 1. Route API requests to PHP router
  RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

  # 2. Route Admin requests to PHP controller
  RewriteRule ^admin(/.*)?$ admin/index.php [QSA,L]

  # 3. Explicitly force all React application routes (including /blog and /blog/*) to index.html
  RewriteRule ^(blog|produits|services|marques|temoignages|devis|recrutement|a-propos|contact|espace-client|intranet)(/.*)?$ index.html [L]

  # 4. If requested static file physically exists (assets, images, etc.), serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 5. Fallback everything else to index.html for React SPA
  RewriteRule ^ index.html [L]
</IfModule>

# ── Security Headers ────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ── Prevent Direct Access to Hidden or Sensitive Files ─────────────
<FilesMatch "^\.(env|git|htaccess)|(\.json|\.sql|\.log|\.md|\.sh|\.lock)$">
  Order allow,deny
  Deny from all
</FilesMatch>
