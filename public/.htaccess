<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow large payload uploads (base64 images, PDFs up to 100MB)
  LimitRequestBody 104857600

  # 1. If requested file physically exists (like assets, images, etc.), serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Route all API requests to the PHP REST router
  RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

  # 3. Route all Admin requests to the Admin PHP controller
  RewriteRule ^admin(/.*)?$ admin/index.php [QSA,L]

  # 4. Fallback to index.html for all React SPA client routes
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Security: prevent direct access to sensitive files
<FilesMatch "^\.(env|git|htaccess)">
  Order allow,deny
  Deny from all
</FilesMatch>
