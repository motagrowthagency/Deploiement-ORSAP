# Configuration Serveur
PORT=3001
NODE_ENV=production
APP_URL=http://localhost:3001
JWT_SECRET=votre_secret_jwt_securise

# Base de données MySQL Heberjahiz
DB_HOST=localhost
DB_PORT=3306
DB_USER=votre_utilisateur_cpanel
DB_PASSWORD=votre_mot_de_passe
DB_NAME=votre_nom_de_base

# Configuration SMTP pour l'envoi d'emails (ex: Heberjahiz / cPanel)
SMTP_HOST=mail.orsap.ma
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orsap@orsap.ma
SMTP_PASS=votre_mot_de_passe_email
SMTP_FROM="ORSAP Maroc <orsap@orsap.ma>"

