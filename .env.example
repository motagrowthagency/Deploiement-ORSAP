# ── Configuration Serveur & Sécurité ─────────────────────────────────
PORT=3001
NODE_ENV=production
APP_URL=https://orsap.ma
ALLOWED_ORIGINS=https://orsap.ma,https://www.orsap.ma

# Clé secrète JWT pour la signature des sessions clients et administrateur (OBLIGATOIRE : chaîne aléatoire longue)
JWT_SECRET=remplacez_par_une_cle_secrete_aleatoire_et_complexe_64_caracteres

# Mot de passe du tableau de bord Administrateur (/admin)
ADMIN_PASSWORD=choisissez_un_mot_de_passe_administrateur_robuste

# ── Base de données MySQL (Heberjahiz / cPanel) ─────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=votre_utilisateur_mysql
DB_PASSWORD=votre_mot_de_passe_mysql
DB_NAME=votre_nom_de_base_mysql

# ── Configuration SMTP pour l'envoi d'emails (Heberjahiz / cPanel) ──
SMTP_HOST=mail.orsap.ma
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orsap@orsap.ma
SMTP_PASS=votre_mot_de_passe_email
SMTP_FROM="ORSAP Maroc <orsap@orsap.ma>"
NOTIFICATION_EMAIL=orsap@orsap.ma

# ── Synchronisation GitHub (Optionnel) ──────────────────────────────
GITHUB_TOKEN=
GITHUB_REPO=motagrowthagency/Deploiement-ORSAP
GITHUB_BRANCH=main
